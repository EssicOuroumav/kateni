# Copie ce fichier en .streamlit/secrets.toml (jamais dans Git) et colle tes adresses Neon.
# Neon : Dashboard > ton projet > Connect > choisis la branche > « Connection string » (avec « Pooled connection »).

[neon]
cible = "prod"   # base utilisée par l'app : "prod" (vrais paris) ou "test"
url = "postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE-pooler.REGION.aws.neon.tech/neondb?sslmode=require"        # branche main
url_test = "postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE-pooler.REGION.aws.neon.tech/neondb?sslmode=require"   # branche test
